  "edidSwitch": {
    "image": "Front",
    "x1": 553,
    "y1": 44,
    "x2": 617,
    "y2": 112,
    "label": "MODE 로터리 스위치",
    "desc": "송신기(Tx) 전면 파란 MODE 로터리 스위치로 EDID를 고른다. 1~E번은 내장 EDID Library, 0번(EXTERNAL)은 EDID S/W 버튼으로 저장한 디스플레이 EDID를 쓴다(EDID Emulation). Default EDID는 1920x1080@60Hz다.",
    "default": "D = 1080p(2CH Audio) · 1920x1080@60Hz(Default EDID)",
    "steps": [
      {
        "title": "EDID 저장(Emulation)",
        "items": [
          "송신기와 디스플레이 기기를 HDMI 케이블로 연결한다.",
          "MODE 로터리 스위치를 0번(EXTERNAL)에 맞추고 EDID S/W 버튼을 누르면 디스플레이 EDID가 송신기 EEPROM에 저장된다. 이후 송신기가 디스플레이 역할을 한다."
        ]
      }
    ],
