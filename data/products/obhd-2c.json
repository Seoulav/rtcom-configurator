  "edidSwitch": {
    "image": "Front",
    "x1": 652,
    "y1": 44,
    "x2": 742,
    "y2": 132,
    "label": "MODE 로터리 스위치",
    "desc": "송신기(TX) 전면 파란 MODE 로터리 스위치로 EDID Library의 해상도를 고른다. EDID S/W 버튼을 누르면 연결한 디스플레이의 EDID를 송신기에 저장할 수 있다(EDID Emulation). 로터리 번호는 매뉴얼 EDID Library 표 순서대로 적었으며 제조사 확인 전이다.",
    "default": "C = HD1080p(2CH) · 1920x1080@60Hz(초기값)",
    "steps": [
      {
        "title": "EDID 저장(Emulation)",
        "items": [
          "송신기와 디스플레이 기기를 HDMI 케이블로 연결한다.",
          "EDID S/W 버튼을 누르면 디스플레이의 EDID 정보가 복사되어 송신기 EEPROM에 저장된다. 이후 송신기가 디스플레이 역할을 한다."
        ]
      }
    ],
